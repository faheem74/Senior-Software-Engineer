# Public site URL (SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB (optional — contact messages use in-memory store when unset)
MONGODB_URI=

# AI assistant (optional — rich FAQ fallback when unset; never dead-ends chat)
# AI_PROVIDER=gemini | groq | openrouter
# Free options: Groq (console.groq.com) or OpenRouter (openrouter.ai)
AI_PROVIDER=
AI_API_KEY=
# Examples: gemini-2.0-flash | llama-3.1-8b-instant | openrouter/auto
AI_MODEL=

# Contact email / SMTP (optional — form validates but reports delivery status honestly)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=faheembilal7874@gmail.com
CONTACT_SENDER_EMAIL=
