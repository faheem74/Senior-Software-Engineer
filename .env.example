# Public site URL (SEO canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB (optional — contact messages use in-memory store when unset)
MONGODB_URI=

# AI assistant (optional — rich FAQ fallback when unset; never dead-ends chat)
# AI_PROVIDER=gemini | groq | openrouter
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Contact email
# Default: FormSubmit → CONTACT_RECEIVER_EMAIL / site email.
# IMPORTANT: Open Gmail once and click FormSubmit "Activate Form" (one-time).
CONTACT_RECEIVER_EMAIL=faheembilal7874@gmail.com
CONTACT_SENDER_EMAIL=

# Optional SMTP (Gmail app password recommended)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Resend (https://resend.com)
RESEND_API_KEY=

# Optional Web3Forms (https://web3forms.com) — free access key
WEB3FORMS_ACCESS_KEY=
